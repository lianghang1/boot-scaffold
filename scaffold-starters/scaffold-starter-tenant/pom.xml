<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfi.scaffold</groupId>
        <artifactId>scaffold-starters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-starter-tenant</artifactId>
    <packaging>jar</packaging>
    <name>scaffold-starter-tenant</name>
    <description>多租户：字段隔离三条通路（JPA Hibernate Filter / Bean Searcher ParamFilter / findById 兜底切面），opt-in 开关</description>

    <dependencies>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-common</artifactId>
        </dependency>
        <!-- 租户上下文唯一来源 = 登录身份（LoginContext/LoginUser），随 security 强依赖 -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-security</artifactId>
        </dependency>

        <!-- 通路可选项：query 在场时装配 BS ParamFilter，缺席静默跳过 -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-query</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 通路可选项：data-jpa 在场时装配 Hibernate Filter / findById 切面，缺席静默跳过 -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test：optional 依赖在本模块测试可见，H2 + data-jpa + bean-searcher 全套齐备 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfi.scaffold</groupId>
        <artifactId>scaffold-starters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-starter-conflux-auth</artifactId>
    <packaging>jar</packaging>
    <name>scaffold-starter-conflux-auth</name>
    <description>Conflux 登录能力桥接：装配 AuthGateway，补 Redis 版 StateCache（集群可用），业务只写 AuthConfigProvider SPI</description>

    <dependencies>
        <!-- conflux 登录门面 starter：core + channels + 自动装配 AuthGateway，版本由 scaffold BOM import 的 conflux BOM 管理 -->
        <dependency>
            <groupId>com.sfi.conflux</groupId>
            <artifactId>conflux-auth-spring-boot-starter</artifactId>
        </dependency>
        <!-- 框架已有 Redis 封装：RedisStateCache 用它落 state，避免重复引入缓存客户端 -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
